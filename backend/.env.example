# Copy this file to .env and fill in real values.

ENV=development
LOG_LEVEL=INFO

# --- Gemini LLM ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Embeddings (Sentence Transformers, downloaded locally, no key needed) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=5

# --- : LightRAG server (Docker) ---
LIGHTRAG_API_URL=http://localhost:9621
LIGHTRAG_API_KEY=
LIGHTRAG_DEFAULT_MODE=hybrid
LIGHTRAG_REQUEST_TIMEOUT_S=120

# ---  Neo4j (used by LightRAG as graph storage, read directly for the Graph tab) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
GRAPH_VIEW_NODE_LIMIT=150



# --- Langfuse observability ---
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
